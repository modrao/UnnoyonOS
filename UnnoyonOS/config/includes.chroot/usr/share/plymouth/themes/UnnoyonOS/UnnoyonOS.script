# UnnoyonOS Plymouth Boot Splash
# macOS-inspired: pure black background, centered white logo, elegant progress bar

# ── Background ────────────────────────────────────────────────────────────────
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

# ── Logo ──────────────────────────────────────────────────────────────────────
logo_image = Image("logo.svg");

# Logo size: 10% of screen width, keep aspect ratio
logo_w = Math.Int(screen_width * 0.10);
logo_h = Math.Int(logo_w * logo_image.GetHeight() / logo_image.GetWidth());

logo_image = logo_image.Scale(logo_w, logo_h);

logo_x = Math.Int((screen_width  - logo_w) / 2);
logo_y = Math.Int((screen_height - logo_h) / 2) - Math.Int(screen_height * 0.06);

logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(logo_x, logo_y, 100);
logo_sprite.SetOpacity(1);

# ── Progress Bar ──────────────────────────────────────────────────────────────
bar_w      = Math.Int(screen_width * 0.18);
bar_h      = 2;
bar_x      = Math.Int((screen_width - bar_w) / 2);
bar_y      = logo_y + logo_h + Math.Int(screen_height * 0.055);

# Background track (dark grey, barely visible)
bar_bg_img = Image.CreateAt(bar_w, bar_h, 0.15, 0.15, 0.15, 0.5);
bar_bg     = Sprite(bar_bg_img);
bar_bg.SetPosition(bar_x, bar_y, 90);

# Foreground fill (white)
progress_image = Image.CreateAt(bar_w, bar_h, 1, 1, 1, 1);
progress_sprite = Sprite();
progress_sprite.SetPosition(bar_x, bar_y, 95);

progress = 0;

fun refresh_callback() {
    progress_sprite.SetImage(progress_image.Scale(Math.Int(bar_w * progress), bar_h));
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Boot Progress ─────────────────────────────────────────────────────────────
fun boot_progress_callback(duration, progress_pct) {
    progress = progress_pct;
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

# ── On Root Mounted ───────────────────────────────────────────────────────────
fun root_mounted_callback() {
    progress = 0.5;
}

Plymouth.SetRootMountedFunction(root_mounted_callback);

# ── Messages (hidden – keep clean look) ───────────────────────────────────────
fun message_callback(text) {
    # Intentionally empty — no boot messages shown, clean macOS-like UI
}

Plymouth.SetMessageFunction(message_callback);

# ── Quit ──────────────────────────────────────────────────────────────────────
fun quit_callback() {
    logo_sprite.SetOpacity(0);
    bar_bg.SetOpacity(0);
    progress_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
